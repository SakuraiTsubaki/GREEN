From GREEN: assign project-specific Japanese GBA runtime identity

Target upstream:
rh-hideout/pokeemerald-expansion@75b806a3ab57a81ff1eb6179288981f0b3cc3050

The four-byte game code below is a GREEN project identifier, not an official
Nintendo/Game Freak product code. Keep GAME_VERSION=LEAFGREEN so the expansion
selects its supported Kanto/FRLG runtime and map assets.

--- a/Makefile
+++ b/Makefile
@@ -14,8 +14,8 @@
 ifeq (leafgreen, $(or $(BUILD), $(MAKECMDGOALS)))
 	GAME_VERSION 	:= LEAFGREEN
-	TITLE       	:= POKEMON LEAF
-	GAME_CODE   	:= BPGE
+	TITLE       	:= PM GREEN REM
+	GAME_CODE   	:= GRXJ
 	BUILD_NAME  	:= leafgreen
 	MAP_VERSION 	:= firered
 endif
@@ -23,7 +23,7 @@
 
 # GBA rom header
-MAKER_CODE  := 01
+MAKER_CODE  := 00
 REVISION    := 0
 KEEP_TEMPS  ?= 0
 
--- a/include/constants/global.h
+++ b/include/constants/global.h
@@ -76,7 +76,7 @@
     #define IS_FRLG 0
     #endif
 #endif
-#define GAME_LANGUAGE (LANGUAGE_ENGLISH)
+#define GAME_LANGUAGE (LANGUAGE_JAPANESE)
 
 // party sizes
 #define PARTY_SIZE 6
 
--- a/src/rom_header_gf.c
+++ b/src/rom_header_gf.c
@@ -99,7 +99,7 @@
 __attribute__((section(".text.header_gf"))) USED static const struct GFRomHeader sGFRomHeader = {
     .version = GAME_VERSION,
     .language = GAME_LANGUAGE,
-    .gameName = "pokemon emerald version",
+    .gameName = "pocket monsters green remake",
     //.monFrontPics = gMonFrontPicTable, // Handled in gSpeciesInfo
     //.monBackPics = gMonBackPicTable, // Handled in gSpeciesInfo
     //.monNormalPalettes = gMonPaletteTable, // Handled in gSpeciesInfo
